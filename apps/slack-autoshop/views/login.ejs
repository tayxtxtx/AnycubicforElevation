<%- include('partials/head', { title: 'Sign in — Autoshop' }) %>

<section class="hero">
  <h1 class="brand">Autoshop</h1>
  <p class="lede">Reserve the Make Nashville lift bay <span class="nowrap">— right from Slack.</span></p>

  <% if (error) { %>
    <div class="alert"><%= error %></div>
  <% } %>

  <a class="cta primary" href="/auth/slack/login">
    <svg viewBox="0 0 122.8 122.8" width="20" height="20" aria-hidden="true">
      <path fill="#E01E5A" d="M25.8 77.6a12.9 12.9 0 1 1-12.9-12.9h12.9zm6.5 0a12.9 12.9 0 1 1 25.8 0v32.3a12.9 12.9 0 1 1-25.8 0z"/>
      <path fill="#36C5F0" d="M45.2 25.8a12.9 12.9 0 1 1 12.9-12.9v12.9zm0 6.5a12.9 12.9 0 1 1 0 25.8H12.9a12.9 12.9 0 1 1 0-25.8z"/>
      <path fill="#2EB67D" d="M97 45.2a12.9 12.9 0 1 1 12.9 12.9H97zm-6.5 0a12.9 12.9 0 1 1-25.8 0V12.9a12.9 12.9 0 1 1 25.8 0z"/>
      <path fill="#ECB22E" d="M77.6 97a12.9 12.9 0 1 1-12.9 12.9V97zm0-6.5a12.9 12.9 0 1 1 0-25.8h32.3a12.9 12.9 0 1 1 0 25.8z"/>
    </svg>
    Sign in with Slack
  </a>
</section>

<ol class="steps">
  <li>
    <span class="step-num">1</span>
    <h3>Sign in</h3>
    <p>Authenticate with the Make Nashville Slack workspace.</p>
  </li>
  <li>
    <span class="step-num">2</span>
    <h3>Pick a time</h3>
    <p>Choose start and duration. Conflicts are caught before you book.</p>
  </li>
  <li>
    <span class="step-num">3</span>
    <h3>Get a reminder</h3>
    <p>Slack DMs you an hour before your slot. Cancel anytime with <code>/bay cancel</code>.</p>
  </li>
</ol>

<footer class="footer">
  <small>Make Nashville · 620 Davidson St</small>
</footer>

<%- include('partials/foot') %>
