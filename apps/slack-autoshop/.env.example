# Slack app credentials (api.slack.com -> Your App -> Basic Information)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Set after the Make Nashville admin installs the app to the workspace.
SLACK_BOT_TOKEN=

# The Make Nashville Slack workspace ID. Used to gate Sign-in-with-Slack
# logins so only workspace members can book.
MAKE_NASHVILLE_TEAM_ID=

# Channel ID (not name) where booking create/cancel announcements are posted.
# Resolve once via Slack -> right-click channel -> Copy link; the trailing
# C-prefix value is the ID.
AUTOSHOP_CHANNEL_ID=

# 32+ random bytes (base64 or hex). Used to encrypt iron-session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Public-facing base URL (no trailing slash). e.g. https://autoshop.makenashville.org
BASE_URL=http://localhost:3000

# SQLite path. On Fly.io with a mounted volume, point this at the volume.
DATABASE_PATH=./data/autoshop.db

# Shared secret required as ?token= on /calendar.ics. Share with members who
# want to subscribe in Google/Apple Calendar.
ICS_TOKEN=

# Booking rules
MAX_DURATION_HOURS=4
BOOKING_WINDOW_DAYS=14
REMINDER_LEAD_MINUTES=60

# Server
PORT=3000
TZ=America/Chicago
LOG_LEVEL=info
