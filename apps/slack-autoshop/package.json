{
  "name": "slack-autoshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slack-integrated reservation system for Make Nashville's autoshop bay.",
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
